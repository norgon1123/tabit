{
  "$schema": "https://design-tokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "slate-900": { "$type": "color", "$value": "#242527" },
      "slate-600": { "$type": "color", "$value": "#4d5359" },
      "slate-100": { "$type": "color", "$value": "#f0f3f5" },
      "white": { "$type": "color", "$value": "#fbfcfd" },
      "accent-600": { "$type": "color", "$value": "#2e4b61" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" }
    }
  },
  "semantic": {
    "color": {
      "ink": { "$type": "color", "$value": "{primitive.color.slate-900}" },
      "ink-soft": { "$type": "color", "$value": "{primitive.color.slate-600}" },
      "surface": { "$type": "color", "$value": "{primitive.color.slate-100}" },
      "bg": { "$type": "color", "$value": "{primitive.color.white}" },
      "accent": { "$type": "color", "$value": "{primitive.color.accent-600}" }
    }
  },
  "component": {
    "button": {
      "bg-primary": { "$type": "color", "$value": "{semantic.color.accent}" }
    }
  }
}
